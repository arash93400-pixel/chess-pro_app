<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>شطرنج پرو</title>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/chess.js/0.10.3/chess.min.js"></script>
<style>
body{font-family:Tahoma,sans-serif;background:#312e2b;color:#fff;margin:0;padding:10px;text-align:center; touch-action: manipulation;}
h2{color:#81b64c;margin:10px 0;font-size:20px}
.board-container{width:100%;max-width:500px;margin:0 auto;position:relative; background:#b58863; border-radius:4px; overflow:hidden; aspect-ratio: 1/1;}
.row{display:flex;width:100%;height:12.5%}
.square{width:12.5%;height:100%;display:flex;justify-content:center;align-items:center;position:relative}
.light{background:#f0d9b5}
.dark{background:#b58863}
.piece{width:100%;height:100%;object-fit:contain;cursor:pointer;user-select:none;-webkit-user-drag:none;}
.selected{background-color:#829769 !important}
.valid-move::after{content:'';position:absolute;width:30%;height:30%;background:rgba(0,0,0,0.2);border-radius:50%}
.valid-capture{box-shadow:inset 0 0 0 4px rgba(0,0,0,0.2); border-radius:50%}
.last-move{background-color:#cdd26a !important}
.panel{background:#262421;max-width:500px;margin:15px auto;padding:15px;border-radius:10px;text-align:right}
select,button{width:100%;padding:12px;margin-top:8px;border-radius:6px;border:none;font-family:Tahoma;font-size:15px}
select{background:#312e2b;color:#fff;border:1px solid #403d39}
button{background:#81b64c;color:#fff;font-weight:bold;cursor:pointer}
.info{background:#312e2b;padding:10px;border-radius:6px;margin-top:10px;text-align:center;border:1px solid #403d39}
.status{margin-top:10px;font-weight:bold;color:#a3d160; font-size: 16px;}
</style>
</head>
<body>

<h2>♟️ شطرنج پرو (آفلاین)</h2>

<div class="board-container" id="board"></div>
<div class="status" id="status">در حال بارگذاری...</div>

<div class="panel">
<label style="color:#989795;font-size:13px">انتخاب حریف:</label>
<select id="botSelect" onchange="changeBot()">
<optgroup label="⭐ شخصیت‌های معروف" id="listFamous"></optgroup>
<optgroup label="🤖 ربات‌های کشوری (150 تا 2800)" id="listBots"></optgroup>
</select>

<div class="info">
<div id="bFlag" style="font-size:28px">🇺🇸</div>
<div id="bName" style="font-weight:bold;color:#81b64c; margin-top:5px;">هیکارو ناکامورا</div>
<div id="bRate" style="color:#989795;font-size:13px; margin-top:5px;">ریتینگ: 3400</div>
</div>

<button onclick="startNewGame()">شروع بازی جدید</button>
</div>

<script>
// عکس‌های مهره‌ها به صورت کد درون‌خطی (بدون نیاز به اینترنت)
var PIECES = {
'wP': 'data:image/svg+xml;base64,',
'wN': 'data:image/svg+xml;base64,',
'wB': 'data:image/svg+xml;base64,',
'wR': 'data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCA0NSA0NSI+PGcgZmlsbD0iI2ZmZiIgc3Ryb2tlPSIjMDAwIiBzdHJva2Utd2lkdGg9IjEuNSI+PHBhdGggZD0iTTkgMzloMjd2LTNIOXptMy0zdi00aDIxdjR6bS0xLTlsNC01aDEzbDR6bTEtNGgyMVYxM0gzMXptNC01VjloNHYyaDVWOXg0djJoNVY5aC0xOHoiLz48L2c+PC9zdmc+',
'wQ': 'data:image/svg+xml;base64,',
'wK': 'data:image/svg+xml;base64,',
'bP': 'data:image/svg+xml;base64,',
'bN': 'data:image/svg+xml;base64,',
'bB': 'data:image/svg+xml;base64,',
'bR': 'data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCA0NSA0NSI+PGcgZmlsbD0iIzAwMCIgc3Ryb2tlPSIjMDAwIiBzdHJva2Utd2lkdGg9IjEuNSI+PHBhdGggZD0iTTkgMzloMjd2LTNIOXptMy0zdi00aDIxdjR6bS0xLTlsNC01aDEzbDR6bTEtNGgyMVYxM0gzMXptNC01VjloNHYyaDVWOXg0djJoNVY5aC0xOHoiLz48L2c+PC9zdmc+',
'bQ': 'data:image/svg+xml;base64,',
'bK': 'data:image/svg+xml;base64,'
};

var game = new Chess();
var boardState = [];
var selectedSquare = null;
var botRating = 3400;
var botFlag = "🇺🇸";
var botName = "هیکارو ناکامورا";
var lastMove = null;

var famousList = [
{name:"هیکارو ناکامورا", rating:3400, flag:"🇺🇸"},
{name:"مگنوس کارلسن", rating:3350, flag:"🇳🇴"},
{name:"علیرضا فیروزجا", rating:3300, flag:"🇫"},
{name:"لوی روزمن", rating:2350, flag:"🇺🇸"},
{name:"الکساندرا بوتز", rating:1950, flag:"🇨🇦"}
];

function initLists() {
var fBox = document.getElementById("listFamous");
for(var i=0; i<famousList.length; i++){
var opt = document.createElement("option");
opt.value = "f" + i;
opt.text = famousList[i].flag + " " + famousList[i].name + " (" + famousList[i].rating + ")";
fBox.appendChild(opt);
}
var bBox = document.getElementById("listBots");
for(var r=150; r<=2800; r+=50){
var opt2 = document.createElement("option");
opt2.value = "b" + r;
var level = r<800 ? "مبتدی" : (r<1500 ? "متوسط" : (r<2200 ? "پیشرفته" : "استاد"));
opt2.text = "🤖 ربات " + level + " - ریتینگ " + r;
bBox.appendChild(opt2);
}
}

function changeBot(){
var val = document.getElementById("botSelect").value;
if(val.charAt(0) === "f"){
var idx = parseInt(val.replace("f",""));
botName = famousList[idx].name;
botRating = famousList[idx].rating;
botFlag = famousList[idx].flag;
} else {
botRating = parseInt(val.replace("b",""));
botName = "ربات هوش مصنوعی";
botFlag = "🤖";
}
document.getElementById("bName").innerText = botName;
document.getElementById("bRate").innerText = "ریتینگ: " + botRating;
document.getElementById("bFlag").innerText = botFlag;
}

function getPieceCode(piece) {
if(!piece) return '';
var color = piece.color === 'w' ? 'w' : 'b';
var type = piece.type.toUpperCase();
return PIECES[color + type] || '';
}

function renderBoard() {
var boardDiv = document.getElementById("board");
boardDiv.innerHTML = '';
var b = game.board();
for(var r=0; r<8; r++) {
var rowDiv = document.createElement("div");
rowDiv.className = "row";
for(var c=0; c<8; c++) {
var sqName = String.fromCharCode(97+c) + (8-r);
var sqDiv = document.createElement("div");
var isLight = (r+c)%2 === 0;
sqDiv.className = "square " + (isLight ? "light" : "dark");
sqDiv.dataset.square = sqName;

if(lastMove && (lastMove.from === sqName || lastMove.to === sqName)) {
sqDiv.classList.add("last-move");
}
if(selectedSquare === sqName) {
sqDiv.classList.add("selected");
}

var piece = b[r][c];
if(piece) {
var img = document.createElement("img");
img.src = getPieceCode(piece);
img.className = "piece";
img.draggable = false;
sqDiv.appendChild(img);
}

// Highlight valid moves
if(selectedSquare) {
var moves = game.moves({square: selectedSquare, verbose: true});
for(var m=0; m<moves.length; m++) {
if(moves[m].to === sqName) {
if(piece) sqDiv.classList.add("valid-capture");
else sqDiv.classList.add("valid-move");
}
}
}

sqDiv.onclick = function() { handleSquareClick(this.dataset.square); };
rowDiv.appendChild(sqDiv);
}
boardDiv.appendChild(rowDiv);
}
}

function handleSquareClick(sq) {
if(game.game_over()) return;
if(game.turn() !== 'w') return; // Only white can move

if(selectedSquare) {
var move = game.move({from: selectedSquare, to: sq, promotion: 'q'});
if(move) {
lastMove = {from: selectedSquare, to: sq};
selectedSquare = null;
renderBoard();
updateStatus();
window.setTimeout(makeBotMove, 500);
return;
}
}

var piece = game.get(sq);
if(piece && piece.color === 'w') {
selectedSquare = sq;
renderBoard();
} else {
selectedSquare = null;
renderBoard();
}
}

function makeBotMove(){
try {
var moves = game.moves();
if(moves.length === 0) return;

var errorChance = 0;
if(botRating < 600) errorChance = 0.6;
else if(botRating < 1200) errorChance = 0.4;
else if(botRating < 1800) errorChance = 0.2;
else if(botRating < 2400) errorChance = 0.1;
else errorChance = 0.02;

var moveStr;
if(Math.random() < errorChance){
moveStr = moves[Math.floor(Math.random() * moves.length)];
} else {
// Simple evaluation for better moves
var bestMove = null;
var bestScore = -9999;
var verboseMoves = game.moves({verbose: true});
for(var i=0; i<verboseMoves.length; i++) {
var m = verboseMoves[i];
game.move(m.san);
var score = evaluateBoard();
game.undo();
if(score > bestScore) {
bestScore = score;
bestMove = m.san;
}
}
// Add some randomness among top moves
moveStr = bestMove || moves[Math.floor(Math.random() * moves.length)];
}

var moveObj = game.move(moveStr);
if(moveObj) {
lastMove = {from: moveObj.from, to: moveObj.to};
}
renderBoard();
updateStatus();
} catch(e) { console.log(e); }
}

function evaluateBoard() {
var totalEvaluation = 0;
var b = game.board();
for (var i = 0; i < 8; i++) {
for (var j = 0; j < 8; j++) {
totalEvaluation = totalEvaluation + getPieceValue(b[i][j]);
}
}
return -totalEvaluation; // Bot is black, wants negative white score
}

function getPieceValue(piece) {
if (piece === null) return 0;
var getAbsoluteValue = function (piece) {
if (piece.type === 'p') return 10;
if (piece.type === 'r') return 50;
if (piece.type === 'n') return 30;
if (piece.type === 'b') return 30;
if (piece.type === 'q') return 90;
if (piece.type === 'k') return 900;
return 0;
};
var absoluteValue = getAbsoluteValue(piece);
return piece.color === 'w' ? absoluteValue : -absoluteValue;
}

function updateStatus(){
var status = "";
var turn = game.turn() === 'w' ? "سفید" : "سیاه";
if(game.in_checkmate()){
status = "کیش و مات! بازی تمام شد.";
} else if(game.in_draw()){
status = "بازی مساوی شد!";
} else {
status = "نوبت: " + turn + (game.in_check() ? " (کیش!)" :